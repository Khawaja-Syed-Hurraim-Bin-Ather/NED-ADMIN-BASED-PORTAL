# EduCompass — Environment Variables (placeholders only — safe to commit)

# ─── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never NEXT_PUBLIC_
DATABASE_URL=                     # server only — never NEXT_PUBLIC_

# ─── Auth ────────────────────────────────────────────────────────
NEXTAUTH_SECRET=                  # generated by the agent
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin ───────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=

# ─── LLM (free tier only — do NOT enable billing) ────────────────
LLM_PROVIDER=gemini               # gemini | groq | openrouter
GEMINI_API_KEY=                   # server only
GROQ_API_KEY=                     # optional fallback
OPENROUTER_API_KEY=               # optional fallback
LLM_MODEL=                        # check current name in provider docs
LLM_MODEL_FALLBACK=

# ─── Embeddings ──────────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini         # gemini | local
EMBEDDING_MODEL=
EMBEDDING_DIM=768

# ─── LLM Limits ──────────────────────────────────────────────────
LLM_MAX_INPUT_CHARS=300
LLM_MAX_OUTPUT_TOKENS=500
LLM_USER_DAILY_LIMIT=
LLM_GLOBAL_DAILY_BUDGET=          # requests per day, below the free quota

# ─── Engine ──────────────────────────────────────────────────────
IMPORTANCE_WEIGHTS=40,25,20,15

# ─── Service Ports ───────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
PIPELINE_PORT=8000
